{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pxtzfabijbgtrminyoce.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "orderup-events",
      "version": "0.4.0",
      "title": "OrderUp Events"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Quem sou eu",
        "description": "Retorna o usuário autenticado no EventFlow (id e e-mail), útil para verificar a conexão MCP.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_events",
        "title": "Listar eventos",
        "description": "Retorna os eventos gastronômicos disponíveis no EventFlow.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filtra por status do evento.",
              "type": "string",
              "enum": [
                "live",
                "upcoming",
                "ended"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_orders",
        "title": "Listar pedidos",
        "description": "Lista os pedidos do EventFlow com paginação e ordenação por data de criação, filtrando por evento, empresa parceira (barraca) e status. Inclui opcionalmente a timeline de cada pedido.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "event_id": {
              "description": "ID do evento, ex.: ev1.",
              "type": "string"
            },
            "stand_name": {
              "description": "Nome da empresa parceira / barraca (busca parcial).",
              "type": "string"
            },
            "status": {
              "description": "Filtra por status do pedido.",
              "type": "string",
              "enum": [
                "awaiting_payment",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ]
            },
            "include_timeline": {
              "description": "Inclui a timeline de cada pedido (padrão: true).",
              "type": "boolean"
            },
            "limit": {
              "description": "Pedidos por página (padrão: 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "page": {
              "description": "Número da página, começando em 1 (padrão: 1).",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sort": {
              "description": "Ordenação por data de criação (padrão: mais recentes primeiro).",
              "type": "string",
              "enum": [
                "created_at_desc",
                "created_at_asc"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_order",
        "title": "Detalhar pedido",
        "description": "Retorna um pedido do EventFlow com itens, status atual e a timeline completa.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "order_id": {
              "type": "string",
              "minLength": 1,
              "description": "ID do pedido, ex.: ord-1042."
            }
          },
          "required": [
            "order_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_order_status",
        "title": "Atualizar status do pedido",
        "description": "Atualiza o status de um pedido (ex.: marcar como pronto), registra automaticamente a timeline e dispara os webhooks cadastrados.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "order_id": {
              "type": "string",
              "minLength": 1,
              "description": "ID do pedido, ex.: ord-1042."
            },
            "status": {
              "type": "string",
              "enum": [
                "awaiting_payment",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ],
              "description": "Novo status do pedido."
            },
            "note": {
              "description": "Observação registrada na timeline.",
              "type": "string",
              "maxLength": 280
            }
          },
          "required": [
            "order_id",
            "status"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "bulk_update_order_status",
        "title": "Atualizar status em lote",
        "description": "Atualiza o status de vários pedidos de uma vez, registra a timeline de cada um e dispara os webhooks. Retorna o resultado individual de cada pedido.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "order_ids": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "IDs dos pedidos, ex.: [\"ord-1042\", \"ord-1043\"]."
            },
            "status": {
              "type": "string",
              "enum": [
                "awaiting_payment",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ],
              "description": "Novo status aplicado a todos os pedidos."
            },
            "note": {
              "description": "Observação registrada na timeline de cada pedido.",
              "type": "string",
              "maxLength": 280
            }
          },
          "required": [
            "order_ids",
            "status"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "subscribe_order_updates",
        "title": "Assinar avisos de pedidos",
        "description": "Cadastra um webhook que recebe um POST em JSON assinado com HMAC-SHA256 sempre que o status de um pedido mudar, com reenvio automático em caso de falha. Pode filtrar por evento e/ou empresa parceira.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "URL https que receberá o POST de notificação."
            },
            "event_id": {
              "description": "Notificar apenas pedidos deste evento.",
              "type": "string"
            },
            "stand_name": {
              "description": "Notificar apenas pedidos desta empresa parceira.",
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_order_subscriptions",
        "title": "Listar avisos cadastrados",
        "description": "Lista os webhooks de notificação de pedidos cadastrados pelo usuário conectado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "unsubscribe_order_updates",
        "title": "Remover aviso de pedidos",
        "description": "Remove um webhook de notificação de pedidos cadastrado pelo usuário conectado.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "webhook_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID do webhook a remover."
            }
          },
          "required": [
            "webhook_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_webhook_deliveries",
        "title": "Auditar entregas de webhooks",
        "description": "Lista as entregas de webhooks do usuário conectado com status, número de tentativas, próximo reenvio e o histórico de cada tentativa.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filtra por status da entrega.",
              "type": "string",
              "enum": [
                "pending",
                "delivered",
                "failed"
              ]
            },
            "webhook_id": {
              "description": "Filtra por webhook.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "order_id": {
              "description": "Filtra por pedido.",
              "type": "string"
            },
            "limit": {
              "description": "Máximo de entregas (padrão: 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "description": "Quantas entregas pular (padrão: 0).",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "retry_webhook_deliveries",
        "title": "Reenviar webhooks",
        "description": "Reenvia agora as entregas pendentes que já passaram do horário de reenvio, ou força o reenvio de uma entrega específica (inclusive falhas definitivas).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "delivery_id": {
              "description": "Entrega específica a reenviar agora.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
