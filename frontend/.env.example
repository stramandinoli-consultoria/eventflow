# Em desenvolvimento deixe VITE_API_URL vazio: o Vite encaminha /api, /hubs e /mcp
# para a API (API_PROXY_TARGET, padrão http://localhost:5080).
VITE_API_URL=
API_PROXY_TARGET=http://localhost:5080

# Em produção, se o front e a API ficarem em domínios diferentes, informe a URL da API:
# VITE_API_URL=https://api.seudominio.com.br
